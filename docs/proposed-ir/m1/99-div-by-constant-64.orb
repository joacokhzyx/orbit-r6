// n / K and n % K for a constant K, 64-bit divisors and dividends (D-M1-96).
// Each `t_K` compares them with the same operation on a divisor that arrives
// as a parameter, which stays a checked division. Both sides print `0`
// mismatches, a checksum, and three sums at the edges, then exit 42.

fn t_p0(n: int, k: int) -> int {
    if n / 2 != n / k {
        return 1
    }
    if n % 2 != n % k {
        return 1
    }
    return 0
}


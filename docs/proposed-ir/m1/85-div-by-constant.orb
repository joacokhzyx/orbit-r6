        return 1
    }
    return 0
}

fn all(n: int) -> int {
    var bad = 0
    bad = bad + t_p2(n, 2)
    bad = bad + t_p3(n, 3)
    bad = bad + t_p5(n, 5)
    bad = bad + t_p6(n, 6)
    bad = bad + t_p7(n, 7)
    bad = bad + t_p9(n, 9)
    bad = bad + t_p10(n, 10)
    bad = bad + t_p11(n, 11)
    bad = bad + t_p12(n, 12)
    bad = bad + t_p13(n, 13)
    bad = bad + t_p25(n, 25)
    bad = bad + t_p60(n, 60)
    bad = bad + t_p100(n, 100)
    bad = bad + t_p125(n, 125)
    bad = bad + t_p641(n, 641)
    bad = bad + t_p1000(n, 1000)
    bad = bad + t_p3600(n, 3600)
    bad = bad + t_p65535(n, 65535)
    bad = bad + t_p65536(n, 65536)
    bad = bad + t_p1000000(n, 1000000)
    bad = bad + t_p1000000007(n, 1000000007)
    bad = bad + t_p2147483647(n, 2147483647)
    bad = bad + t_p1073741824(n, 1073741824)
    bad = bad + t_p1073741825(n, 1073741825)
    bad = bad + t_n2(n, -2)
    bad = bad + t_n3(n, -3)
    bad = bad + t_n5(n, -5)
    bad = bad + t_n7(n, -7)
    bad = bad + t_n10(n, -10)
    bad = bad + t_n100(n, -100)
    bad = bad + t_n641(n, -641)
    bad = bad + t_n65536(n, -65536)
    bad = bad + t_n2147483647(n, -2147483647)
    bad = bad + t_p1(n, 1)
    bad = bad + t_p4(n, 4)
    bad = bad + t_p8(n, 8)
    bad = bad + t_p16(n, 16)
    bad = bad + t_n4(n, -4)
    bad = bad + t_n8(n, -8)
    bad = bad + t_n1073741824(n, -1073741824)
    return bad
}

fn sum(n: int) -> int {
    return n / 3 + n % 3 + n / 7 + n % 7 + n / 10 + n % 10 + n / 1000 + n % 1000 + n / 8 + n % 8
}

fn main() -> int {
    val top = 2147483647
    val low = 0 - top - 1
    var bad = all(0) + all(1) + all(0 - 1) + all(top) + all(low) + all(top - 1) + all(low + 1)
    var n = 0 - 300
    while n <= 300 {
        bad = bad + all(n)
        n = n + 1
    }
    var x = 12345
    var i = 0
    var check = 0
    while i < 3000 {
        x = x * 1103515245 + 12345
        bad = bad + all(x)
        check = check + sum(x)
        i = i + 1
    }
    print(bad)
    print(check)
    print(sum(low))
    print(sum(top))
    print(sum(0 - 7))
    return 42
}

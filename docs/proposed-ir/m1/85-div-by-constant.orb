// D-M1-81: `n / K` and `n % K` for a constant K are a multiply and shifts.
// Each `t_K` compares them with the same operation on a divisor that arrives
// as a parameter, which stays a division, for edge values and a 32-bit
// linear congruential sweep. The oracle and R6 print `0` mismatches, a checksum
// of the quotients and remainders, and three sums at the edges, then exit 42.
fn t_p2(n: int, k: int) -> int {
    if n / 2 != n / k {
        return 1
    }
    if n % 2 != n % k {
        return 1
    }
    return 0
}


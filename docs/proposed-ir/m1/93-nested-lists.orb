// D-M1-90: elements of nested lists. The builder types the outer read `list`
// and the inner reads `void*`, because it names no element type below one
// level. The C casts the word to a list for the next read and adds, subtracts
// or multiplies the words as uintptr_t before it narrows the result to int.
// expect-exit 42

fn main() -> int {
    val xs: list < list < int >> = [[5, 6], [7, 8, 9]]
    val ys: list < list < list < int >> > = [[[7, 1], [2]], [[3]]]
    if xs[0][0] + ys[0][0][0] != 12 { return 1 }
    if xs[1][2] - xs[0][1] != 3 { return 2 }
    if xs[1][0] * ys[1][0][0] != 21 { return 3 }
    if ys[0][1][0] + ys[1][0][0] != 5 { return 4 }
    if xs[1][1] - ys[0][0][1] != 7 { return 5 }
    print(xs[1].len())
    return 42
}

fn locate(hay: string, needle: string) -> int {
    return hay.indexOf(needle)
}

fn main() -> int {
    val s = "orbit native"
    if s.indexOf("native") != 6 { return 10 }
    if s.indexOf("zzz") != -1 { return 11 }
    if s.find("bit") != 2 { return 12 }
    if locate(s, "o") != 0 { return 13 }
    if locate("", "a") != -1 { return 14 }
    print("found")
    return 42
}

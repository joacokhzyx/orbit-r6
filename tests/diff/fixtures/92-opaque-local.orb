// D-M1-89: an element read from a list the builder cannot type, bound to a
// local with `val b = bs.get(i)`. The C declares the local as a word and reads
// it back as an int, so the word takes the type of the loads of `b`.
// orbit_random_bytes gives the untyped list; only values that do not vary
// between runs are printed.
// expect-exit 42

extern fn orbit_random_bytes(count: int) -> result

fn randomBytes(n: int) -> result {
    return orbit_random_bytes(n)
}

fn main() -> int {
    val bs: list = try randomBytes(64) catch { return 1 }
    var in_range = 0
    var spread = 0
    var i = 0
    while i < bs.len() {
        val b = bs.get(i)
        if b < 0 || b > 255 { return 2 }
        in_range = in_range + 1
        if b > 127 { spread = spread + 1 }
        i = i + 1
    }
    print(in_range)
    print(spread <= in_range)
    return 42
}

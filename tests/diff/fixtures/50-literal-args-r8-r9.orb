fn mix(s: string, a: int, b: int, c: int) -> int {
    return s.len() + a + b + c
}

fn spread(x: int, y: int, label: string, z: int) -> int {
    return x + y + z + label.len()
}

fn main() -> int {
    if mix("abc", 1, 2, -3) != 3 { return 10 }
    if spread(5, 6, "four", -7) != 8 { return 11 }
    print(mix("hello", 10, 20, 30))
    return 42
}
